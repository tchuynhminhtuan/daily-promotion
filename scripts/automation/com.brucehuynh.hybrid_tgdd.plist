<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.brucehuynh.hybrid_tgdd</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/open</string>
        <string>/Users/brucehuynh/GitHub/daily-promotion/scripts/automation/run_hybrid_terminal.command</string>
    </array>
    <key>RunAtLoad</key>
    <false/>
    <!-- Quét 3 lần một ngày: 08:30, 14:00, 22:30 -->
    <key>StartCalendarInterval</key>
    <array>
        <!-- Khung 1: 08:30 Sáng (Mở cửa quầy & nhận hàng) -->
        <dict>
            <key>Hour</key>
            <integer>8</integer>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
        <!-- Khung 2: 14:00 Chiều (Giữa ngày / sau đổi ca) -->
        <dict>
            <key>Hour</key>
            <integer>14</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <!-- Khung 3: 22:30 Tối (Đóng cửa siêu thị & chốt tồn) -->
        <dict>
            <key>Hour</key>
            <integer>22</integer>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
    </array>
    <key>StandardOutPath</key>
    <string>/tmp/tgdd_hybrid_scrape.out</string>
    <key>StandardErrorPath</key>
    <string>/tmp/tgdd_hybrid_scrape.err</string>
</dict>
</plist>
