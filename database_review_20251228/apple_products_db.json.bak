  "Smart Folio cho iPad (A16)": {
    "Model": "Smart Folio cho iPad (A16)",
    "Family": "iPad",
    "Specs": {
      "Màu": [
        "Màu Trời\n\nTrắng\n\nDưa Hấu\n\nVàng Chanh"
      ],
      "Tổng Quan": [
        "Smart Folio cho iPad (A16) mỏng và nhẹ, có chức năng bảo vệ cả mặt trước và mặt sau của thiết bị. Smart Folio tự động đánh thức iPad khi mở ra và chuyển máy về chế độ ngủ khi đóng lại. Smart Folio gắn kết bằng nam châm và bạn có thể dễ dàng gấp theo nhiều cách khác nhau để tạo thành chân đỡ máy khi đọc, xem, gõ phím hoặc gọi FaceTime."
      ],
      "Trong hộp có gì": [
        "Smart Folio"
      ],
      "Tương thích": [
        "Các Phiên Bản iPad\n\niPad (A16)\n\niPad (thế hệ thứ 10)"
      ]
    },
    "Docs_Url": "https://support.apple.com/vi-vn/docs/ipad/pp731",
    "Specs_Url": "https://support.apple.com/vi-vn/122274"
  },
