  "Apple Pencil (USB-C)": {
    "Model": "Apple Pencil (USB-C)",
    "Family": "Unknown",
    "Specs": {
      "Tổng Quan": [
        "Apple Pencil (USB-C) là lựa chọn lý tưởng để ghi chú, phác họa, đánh dấu tài liệu, viết nhật ký và xử lý nhiều thao tác khác. Sản phẩm đem đến độ chính xác hoàn hảo đến từng điểm ảnh, độ trễ thấp và nhạy với độ nghiêng. Bút cho độ cảm nhận tự nhiên cứ như dùng bút chì.\n\nApple Pencil (USB-C) ghép đôi và sạc qua Cáp Sạc USB-C. Bút dễ cất nhờ gắn kết nam châm lên cạnh của iPad.\n\nApple Pencil (USB-C) hỗ trợ tính năng lướt Apple Pencil khi sử dụng với iPad Pro 13 inch (M4), iPad Pro 11 inch (M4), iPad Pro 12,9 inch (thế hệ thứ 6), iPad Pro 11 inch (thế hệ thứ 4), iPad Air 13 inch (M2) và iPad Air 11 inch (M2)."
      ],
      "Trong hộp có gì": [
        "Apple Pencil (USB-C)"
      ],
      "Kích Thước Và Trọng Lượng": [
        "Dài: 155 mm (6,10 inch)\n\nĐường kính: 8,9 mm (0,35 inch)\n\nTrọng lượng: 20,5 g (0,72 ounce)"
      ],
      "Kết Nối": [
        "Bluetooth\n\nCổng kết nối USB-C"
      ],
      "Các Tính Năng Khác": [
        "Gắn kết bằng nam châm"
      ],
      "Yêu Cầu Hệ Thống": [
        "iPadOS 17.1.1 trở lên"
      ],
      "Tương thích": [
        "Các Phiên Bản iPad",
        "iPad Pro 13 inch (M4)\n\niPad Pro 12,9 inch (thế hệ thứ 6)\n\niPad Pro 12,9 inch (thế hệ thứ 5)\n\niPad Pro 12,9 inch (thế hệ thứ 4)\n\niPad Pro 12,9 inch (thế hệ thứ 3)\n\niPad Pro 11 inch (M4)\n\niPad Pro 11 inch (thế hệ thứ 4)\n\niPad Pro 11 inch (thế hệ thứ 3)\n\niPad Pro 11 inch (thế hệ thứ 2)\n\niPad Pro 11 inch (thế hệ thứ 1)\n\niPad Air 13 inch (M2)\n\niPad Air 11 inch (M2)\n\niPad Air (thế hệ thứ 5)\n\niPad Air (thế hệ thứ 4)\n\niPad (thế hệ thứ 10)\n\niPad mini (thế hệ thứ 6)"
      ]
    },
    "Docs_Url": "https://support.apple.com/vi-vn/docs/ipad/301007",
    "Specs_Url": "https://support.apple.com/vi-vn/121318"
  },
