  "Magic Keyboard cho iPad Air 11 inch (M3)": {
    "Model": "Magic Keyboard cho iPad Air 11 inch (M3)",
    "Family": "iPad",
    "Specs": {
      "Màu": [
        "Trắng\n\nĐen"
      ],
      "Tổng Quan": [
        "Magic Keyboard là người bạn đồng hành hoàn hảo dành cho iPad Air. Bàn phím này mang đến trải nghiệm gõ phím tuyệt vời và bàn di cho các tác vụ đòi hỏi sự chính xác trong một thiết kế trang nhã, gọn nhẹ. Bàn phím bao gồm một dãy 14 phím chức năng, một cổng USB-C để sạc nối tiếp và khả năng bảo vệ cả mặt trước và mặt sau iPad. Thiết kế kiểu trục lơ lửng giúp dễ dàng điều chỉnh theo các góc nhìn khác nhau và bàn di bằng kính lớn giúp bạn có thêm nhiều cách để làm việc với iPadOS."
      ],
      "Điểm nổi bật": [
        "Thiết kế kiểu trục lơ lửng nhỏ gọn mang đến khả năng điều chỉnh góc mượt mà cùng góc nhìn hoàn hảo.\n\nBàn di bằng kính lớn mang lại trải nghiệm nhanh nhạy và trực quan.\n\nDãy 14 phím chức năng giúp truy cập thuận tiện vào các tính năng như điều khiển độ sáng màn hình, âm lượng và các tính năng khác.\n\nTrải nghiệm gõ phím thoải mái cùng cơ chế cắt kéo với hành trình phím 1 mm.\n\nĐược thiết kế cho các thao tác Multi‑Touch và con trỏ trong iPadOS.\n\nCổng USB-C để sạc iPad Air, giải phóng cổng trên iPad để gắn những phụ kiện khác.\n\nGấp thành ốp để bảo vệ mặt trước và mặt sau khi di chuyển với iPad Air."
      ],
      "Yêu Cầu Hệ Thống": [
        "Yêu cầu iPadOS 18.3 trở lên."
      ],
      "Tương thích": [
        "Các Phiên Bản iPad\n\niPad Air 11 inch (M3)\n\niPad Air 11 inch (M2)\n\niPad Air (thế hệ thứ 5)\n\niPad Air (thế hệ thứ 4)"
      ]
    },
    "Docs_Url": "https://support.apple.com/vi-vn/docs/ipad/301275",
    "Specs_Url": "https://support.apple.com/vi-vn/122272"
  },
