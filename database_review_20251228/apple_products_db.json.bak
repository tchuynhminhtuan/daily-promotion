  "Pin MagSafe của iPhone Air": {
    "Model": "Pin MagSafe của iPhone Air",
    "Family": "iPhone",
    "Specs": {
      "Tổng Quan": [
        "Thiết kế mỏng và nhẹ",
        "Pin MagSafe cho iPhone Air được chế tạo dành riêng cho iPhone Air. Được thiết kế để cất gọn vào túi, phụ kiện này mang lại cảm giác tuyệt vời khi cầm trên tay và cho phép sạc thêm đến 65% pin cho iPhone Air, kéo dài thời lượng pin hơn so với bất kỳ chiếc iPhone nào khác.¹",
        "Nhận biết thời điểm sạc thông minh",
        "Gắn Pin MagSafe vào iPhone Air đã sạc đầy để sử dụng cả ngày. Để tối đa hóa thời lượng pin, hệ thống kết hợp sẽ chọn thời điểm hợp lý nhất để sạc. Hoặc khi cần sạc nhanh, bạn chỉ cần gắn vào điện thoại để sạc nhanh không dây với công suất lên đến 12W khi đang di chuyển.",
        "Sạc nhanh",
        "Để sạc iPhone Air nhanh hơn nữa, gắn Pin MagSafe và kết nối iPhone Air với bộ tiếp hợp nguồn từ 20W trở lên cùng một lúc.²"
      ],
      "Điểm nổi bật": [
        "Thiết kế mỏng và nhẹ\n\nSạc thêm lên đến 65% cho iPhone Air\n\nSạc không dây nhanh lên đến 12W khi đang di chuyển\n\nSạc các phụ kiện nhỏ hơn qua USB-C"
      ],
      "Trong hộp có gì": [
        "Pin MagSafe cho iPhone Air"
      ],
      "Tương thích": [
        "Các Phiên Bản iPhone",
        "iPhone Air"
      ]
    },
    "Docs_Url": "https://support.apple.com/vi-vn/docs/iphone/301248",
    "Specs_Url": "https://support.apple.com/vi-vn/125312"
  },
