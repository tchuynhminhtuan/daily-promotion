  "Gói pin MagSafe": {
    "Model": "Gói pin MagSafe",
    "Family": "Unknown",
    "Specs": {
      "Tổng Quan": [
        "Sạc bằng Pin Dự Phòng MagSafe thật quá đơn giản. Thiết kế nhỏ gọn, tiện lợi giúp bạn sạc pin thật dễ dàng khi đang di chuyển. Các nam châm căn chuẩn vị trí sạc đảm bảo kết nối ổn định với iPhone 12 và iPhone 12 Pro, iPhone 13 và iPhone 13 Pro hoặc iPhone 14 và 14 Pro, cho bạn tiện ích sạc không dây an toàn và hiệu quả. Thiết bị này sạc tự động, do đó bạn không cần phải bật hay tắt gì cả. Hoàn toàn không ảnh hưởng gì đến thẻ tín dụng hay thiết bị điều khiển cầm tay của bạn.",
        "Bạn đang ngồi ở bàn làm việc và cần sạc pin? Chỉ cần cắm cáp Lightning vào Pin Dự Phòng MagSafe để sạc không dây với công suất lên đến 15W. Bạn không có nhiều thời gian? Với bộ sạc có công suất cao hơn 20W, bạn có thể sạc đồng thời Pin Dự Phòng MagSafe và iPhone thậm chí còn nhanh hơn. Ngoài ra, bạn có thể theo dõi trạng thái sạc trên Màn Hình Khóa.",
        "Khuyến nghị:",
        "Bộ Sạc USB-C công suất 20W trở lên và Cáp USB-C sang Lightning (không bán kèm)\n\nĐể biết thêm thông tin, vui lòng xem bài viết này"
      ],
      "Điểm nổi bật": [
        "Cho phép sạc thêm đến 70% với iPhone 12 mini hoặc iPhone 13 và Pin Dự Phòng MagSafe*\n\nCho phép sạc thêm đến 60% với iPhone 12, iPhone 12 Pro, iPhone 13, iPhone 13 Pro, iPhone 14 hoặc iPhone 14 Pro và Pin Dự Phòng MagSafe*\n\nCho phép sạc thêm tới 40% với iPhone 12 Pro Max, iPhone 13 Pro Max, iPhone 14 Plus, hoặc iPhone 14 Pro Max và Pin Dự Phòng MagSafe*"
      ],
      "Trong hộp có gì": [
        "Pin Dự Phòng MagSafe\n\nLưu ý: Bộ sạc và cáp không bán kèm"
      ],
      "Tương thích": [
        "Các Phiên Bản iPhone\n\niPhone 14 Pro\n\niPhone 14 Pro Max\n\niPhone 14\n\niPhone 14 Plus\n\niPhone 13 Pro\n\niPhone 13 Pro Max\n\niPhone 13 mini\n\niPhone 13\n\niPhone 12 Pro\n\niPhone 12 Pro Max\n\niPhone 12 mini\n\niPhone 12"
      ]
    },
    "Docs_Url": "https://support.apple.com/vi-vn/docs/iphone/300414",
    "Specs_Url": "https://support.apple.com/vi-vn/111857"
