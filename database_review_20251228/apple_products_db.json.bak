  "Apple Pencil Pro": {
    "Model": "Apple Pencil Pro",
    "Family": "Unknown",
    "Specs": {
      "Tổng Quan": [
        "Apple Pencil Pro mang đến thêm bao năng lực kỳ diệu giúp bạn hiện thực hóa những ý tưởng của mình. Các tính năng tiên tiến mới giúp việc đánh dấu, ghi chú và tạo ra một kiệt tác trở nên trực quan hơn bao giờ hết.",
        "Bóp. Khi bạn bóp, Apple Pencil Pro có thể nhận biết được thao tác bóp của bạn và hiển thị một bảng màu mới, giúp bạn nhanh chóng chuyển đổi giữa các công cụ, độ dày mỏng của nét vẽ và màu sắc.",
        "Xoay thân bút. Con quay hồi chuyển mới cho phép bạn xoay Apple Pencil Pro để kiểm soát chính xác các công cụ bút và cọ.",
        "Phản hồi cảm ứng. Bộ phản hồi cảm ứng tùy chỉnh tạo ra phản hồi chính xác cho cảm nhận của bạn. Khi bạn bóp hoặc chạm hai lần, bạn sẽ cảm thấy thiết bị rung nhẹ để xác nhận hành động.",
        "Lướt Apple Pencil.¹ Xem trước chính xác vị trí Apple Pencil sẽ chạm xuống màn hình và thấy được bóng ảo của công cụ bạn đang dùng. Nhờ đó, bạn có thể viết, phác thảo và vẽ minh họa với độ chính xác còn cao hơn nữa.",
        "Chạm hai lần. Nhanh chóng chuyển đổi giữa các công cụ như bút và tẩy bằng cách chạm hai lần vào Apple Pencil.",
        "Đồng thời, nếu không nhớ mình để Apple Pencil Pro ở đâu trong lúc ra ngoài hay khi ở nhà, bạn có thể dễ dàng định vị vị trí của bút trên ứng dụng Tìm. Apple Pencil Pro gắn, kết nối và sạc từ tính ở mặt bên của iPad."
      ],
      "Trong hộp có gì": [
        "Apple Pencil Pro"
      ],
      "Kích Thước Và Trọng Lượng": [
        "Dài: 166 mm (6,53 inch)\n\nĐường kính: 8,9 mm (0,35 inch)\n\nTrọng lượng: 19,15 gram (0,68 ounce)"
      ],
      "Kết Nối": [
        "Bluetooth"
      ],
      "Các Tính Năng Khác": [
        "Gắn, kết nối và sạc từ tính"
      ],
      "Yêu Cầu Hệ Thống": [
        "iPadOS 17.5 trở lên"
      ],
      "Tương thích": [
        "Các Phiên Bản iPad\n\niPad Pro 13 inch (M4)\n\niPad Pro 11 inch (M4)\n\niPad Air 13 inch (M2)\n\niPad Air 11 inch (M2)\n\niPad mini (A17 Pro)"
      ]
    },
    "Docs_Url": "https://support.apple.com/vi-vn/docs/ipad/301035",
    "Specs_Url": "https://support.apple.com/vi-vn/120123"
  },
