  "Magic Keyboard cho iPad Pro 11 inch (M4 và M5)": {
    "Model": "Magic Keyboard cho iPad Pro 11 inch (M4 và M5)",
    "Family": "iPad",
    "Specs": {
      "Màu": [
        "Trắng\n\nĐen"
      ],
      "Tổng Quan": [
        "Magic Keyboard cho iPad Pro mang đến trải nghiệm gõ phím và bàn di tuyệt vời, trong một thiết kế trang nhã, nhỏ gọn cùng phần kê tay bằng nhôm. Bàn phím có dãy 14 phím chức năng cho phép truy cập nhanh để điều chỉnh độ sáng màn hình, âm lượng và các tính năng khác, cùng cổng kết nối USB-C để sạc nối tiếp. Thiết kế kiểu trục lơ lửng giúp dễ dàng điều chỉnh theo các góc nhìn khác nhau.",
        "Bàn di lớn với phản hồi cảm ứng hoàn hảo cho các tác vụ cần độ chính xác như chỉnh sửa trang tính và chọn văn bản, hay đơn giản là điều hướng iPad của bạn bằng các thao tác Multi-Touch trực quan và quen thuộc. Và vỏ ngoài bền bỉ mang đến khả năng bảo vệ cả mặt trước và mặt sau, hoàn hảo để mang iPad Pro đi bất cứ đâu."
      ],
      "Điểm nổi bật": [
        "Thiết kế kiểu trục đỡ mỏng và nhỏ gọn cho khả năng điều chỉnh góc mượt mà và mang đến góc nhìn hoàn hảo.\n\nBàn di tích hợp lớn hơn bằng kính với phản hồi cảm ứng.\n\nDãy 14 phím chức năng cho phép truy cập nhanh để điều chỉnh độ sáng màn hình, âm lượng cũng như các tính năng khác.\n\nPhím có đèn nền dễ chịu và cơ chế chuyển đổi dạng cắt kéo với hành trình phím 1 mm cho phép gõ phím êm và nhạy.\n\nĐược thiết kế cho các thao tác Multi‑Touch và con trỏ trong iPadOS.\n\nBản lề nhôm gia công bền bỉ với cổng kết nối USB-C.\n\nGấp thành ốp để bảo vệ mặt trước và mặt sau khi di chuyển với iPad Pro."
      ],
      "Yêu Cầu Hệ Thống": [
        "Yêu cầu iPadOS 17.4 trở lên."
      ],
      "Tương thích": [
        "Các Phiên Bản iPad\n\niPad Pro 11 inch (M5)\n\niPad Pro 11 inch (M4)"
      ]
    },
    "Docs_Url": "https://support.apple.com/vi-vn/docs/ipad/301036",
    "Specs_Url": "https://support.apple.com/vi-vn/120125"
  },
